; Script generated by Inno Setup for SmileUp VST3
#define MyAppName "SmileUp"
#define MyAppVersion "1.0.0"
#define MyAppPublisher "SmileUp Audio"
#define MyAppURL "https://github.com/MiguelC21/SmileUp"

[Setup]
AppId={{E5D90F57-8C8B-4C82-95C7-3FE7314CEB7D}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={commoncf}\VST3
DisableDirPage=yes
DefaultGroupName={#MyAppName}
DisableProgramGroupPage=yes
OutputBaseFilename=SmileUp_Setup_v1.0.0
OutputDir=output
Compression=lzma2/ultra64
SolidCompression=yes
WizardStyle=modern
ArchitecturesInstallIn64BitMode=x64compatible
PrivilegesRequired=admin

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"
Name: "spanish"; MessagesFile: "compiler:Languages\Spanish.isl"

[Files]
; Primary VST3 Bundle
Source: "..\build\SmileUp_artefacts\Release\VST3\SmileUp.vst3\*"; DestDir: "{commoncf}\VST3\SmileUp.vst3"; Flags: ignoreversion recursesubdirs createallsubdirs
; Compatibility bundle for FL Studio projects referenced as smile_up
Source: "..\build\SmileUp_artefacts\Release\VST3\SmileUp.vst3\*"; DestDir: "{commoncf}\VST3\smile_up.vst3"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "..\build\SmileUp_artefacts\Release\VST3\SmileUp.vst3\Contents\x86_64-win\SmileUp.vst3"; DestDir: "{commoncf}\VST3\smile_up.vst3\Contents\x86_64-win"; DestName: "smile_up.vst3"; Flags: ignoreversion

[UninstallDelete]
Type: filesandordirs; Name: "{commoncf}\VST3\SmileUp.vst3"
Type: filesandordirs; Name: "{commoncf}\VST3\smile_up.vst3"
